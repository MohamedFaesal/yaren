# Point this at your dedicated Postgres host (not a container in this compose file).
DATABASE_URL=postgres://yaren:CHANGE_ME@postgres.example.internal:5432/yaren

# Required in production. Use a long random secret.
JWT_SECRET=replace-with-a-long-random-secret

HOST=0.0.0.0
PORT=3000

# First boot creates this account if it does not already exist.
SEED_SUPER_ADMIN_EMAIL=super-admin@yaren.health
SEED_SUPER_ADMIN_PASSWORD=ChangeMe!2026
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_PHONE=01000000000

# Web/nginx is not published on the host. Put Caddy (or another reverse proxy)
# in front and point it at http://web:80 on the Docker network named "yaren".
